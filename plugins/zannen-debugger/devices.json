      "label": "ZannenDongle33 接收器",
      "mcu": "nRF52833",
      "uf2_family": "0x621e937a",
      "capabilities": ["rf", "uf2", "serial", "ble"],
      "match": {
        "hw_names": ["zannendongle33_uf2", "zannen-dongle33", "zannendongle33"],
